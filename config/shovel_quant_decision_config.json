{
  "version": "2.0.0-quant-primary",
  "as_of": "2026-09-28",
  "description": "Shovel Primary Quant Decision Engine & Timeframe-Noise Adaptation Configuration",
  
  "primary_weights": {
    "w_kalman": 0.20,
    "w_changepoint": 0.15,
    "w_hurst": 0.15,
    "w_momentum": 0.15,
    "w_relative_strength": 0.10,
    "w_macro": 0.10,
    "w_fundamental": 0.15,
    "w_risk_penalty": 0.25
  },
  
  "secondary_indicators": {
    "status": "SECONDARY_SUPPORT_ONLY",
    "can_trigger_primary_decision": false,
    "max_aggregate_weight": 0.05,
    "indicators": ["RSI", "MACD", "EMA_SMA_CROSS", "BOLLINGER", "STOCHASTIC"]
  },

  "timeframe_horizons": {
    "short_term": ["15m", "1h", "4h"],
    "medium_term": ["1d", "1w"],
    "long_term": ["1w", "1m"]
  },

  "model_timeframe_suitability": {
    "kalman_filter": {
      "suitable_timeframes": ["1h", "4h", "1d"],
      "adaptive_noise": true,
      "base_q": 0.0001,
      "base_r": 0.0025
    },
    "changepoint_detection": {
      "suitable_timeframes": ["4h", "1d", "1w"],
      "min_observations": 30
    },
    "hurst_exponent": {
      "suitable_timeframes": ["1d", "1w"],
      "min_observations": 50,
      "chop_range": [0.45, 0.55],
      "trend_threshold": 0.55,
      "mean_reverting_threshold": 0.45
    },
    "ewma_volatility": {
      "suitable_timeframes": ["1h", "4h", "1d"],
      "lambda_by_asset_class": {
        "crypto": {"1h": 0.90, "4h": 0.92, "1d": 0.94},
        "us_equities": {"1h": 0.94, "4h": 0.95, "1d": 0.96},
        "bist_equities": {"1h": 0.93, "4h": 0.94, "1d": 0.95},
        "forex_commodities": {"1h": 0.95, "4h": 0.96, "1d": 0.97}
      }
    },
    "volatility_adjusted_momentum": {
      "suitable_timeframes": ["4h", "1d", "1w"],
      "horizons_by_asset_class": {
        "crypto": 14,
        "us_equities": 21,
        "bist_equities": 21,
        "forex_commodities": 30
      }
    },
    "var_cvar": {
      "suitable_timeframes": ["1d", "1w"],
      "confidence_level": 0.95,
      "critical_cvar_threshold_pct": -6.5
    },
    "macro_and_fundamental": {
      "suitable_timeframes": ["1w", "1m"],
      "daily_role": "REGIME_FILTER_ONLY"
    },
    "rsi_macd": {
      "suitable_timeframes": ["15m", "1h", "4h", "1d", "1w", "1m"],
      "weight_multiplier": {
        "15m": 0.10,
        "1h": 0.20,
        "4h": 0.50,
        "1d": 0.70,
        "1w": 0.30,
        "1m": 0.10
      }
    }
  },

  "noise_adaptation": {
    "noise_ratio_formula": "realized_vol_short / realized_vol_long",
    "short_vol_window": 5,
    "long_vol_window": 20,
    "elevated_noise_threshold": 1.35,
    "high_noise_threshold": 1.70,
    "damping_factor_short_term": 0.40,
    "threshold_expansion_factor": 1.25,
    "auto_demote_to_izleme_if_noise_gt": 1.85
  },

  "portfolio_and_correlation": {
    "high_correlation_threshold": 0.75,
    "cluster_max_weight_pct": 25.0,
    "marginal_cvar_limit_pct": 2.0
  },

  "decision_thresholds": {
    "uygun_min_score": 0.40,
    "kacin_max_score": -0.20,
    "min_data_quality_pct": 80.0
  },

  "controlled_rollout": {
    "status": "PHASED_ROLLOUT_ACTIVE",
    "as_of": "2026-09-28",
    "real_orders_globally_disabled": true,
    "ui_global_banner": "Quant karar motoru aktif — paper/araştırma modu. Gerçek emir gönderilmez.",

    "asset_class_modes": {
      "bist_equities": {
        "mode": "ACTIVE_PRIMARY",
        "description": "Yeni quant motoru birincil karar motorudur. UYGUN/İZLEME/KAÇIN üretir. Paper trading aktiftir.",
        "real_orders": false,
        "paper_logging": true,
        "vetoes_active": ["cvar", "data_quality", "timeframe_conflict", "hurst_chop"]
      },
      "us_equities": {
        "mode": "SHADOW_PARALLEL",
        "description": "Eski ve yeni model paralel çalışır. Yeni model ana ekranda, eski model karşılaştırmada gösterilir. Çelişkide otomatik İZLEME üretilir.",
        "real_orders": false,
        "paper_logging": true,
        "conflict_arbitration": "AUTO_DEMOTE_TO_IZLEME",
        "required_oos_signals_for_legacy_retirement": 30
      },
      "crypto": {
        "mode": "RESEARCH_AND_DATA_ONLY",
        "description": "LONG/SHORT, kaldıraç, hedef fiyat ve işlem önerisi KAPALIDIR. Yalnızca veri, volatilite, conformal aralık ve backtest gösterilir.",
        "trading_signals_allowed": false,
        "real_orders": false,
        "paper_logging": false,
        "allowed_display": ["data", "quant_metrics", "volatility", "conformal_interval", "backtest_status"]
      }
    },

    "active_gates": {
      "same_date_range": true,
      "same_snapshot_id_logic": true,
      "same_cost_model": true,
      "same_initial_capital": true,
      "same_benchmark": true,
      "same_position_size": true,
      "same_frequency": true,
      "same_raw_schema": true
    },

    "circuit_breaker": {
      "max_consecutive_negative_periods": 2,
      "max_acceptable_brier_score": 0.28,
      "critical_cvar_limit_pct": -8.0,
      "on_trip_action": "REVERT_TO_PASSIVE_WATCH"
    }
  }
}
